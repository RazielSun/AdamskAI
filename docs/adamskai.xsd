        <xs:annotation><xs:documentation>Float, default 600.0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="MoveTo">
    <xs:annotation><xs:documentation>Path-follows the pawn to `in-goal` within `acceptanceRadius`, re-pathing when the slot moves farther than `repathDistance` (0: never). Succeeds on arrival; with `allowPartialPath` (default) a goal no path reaches is approached as far as possible and the move succeeds there, without it the move fails. A goal off the navmesh fails, and so does a brain without an AI controller.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="acceptanceRadius" type="Float">
        <xs:annotation><xs:documentation>Float, default 50.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="allowPartialPath" type="Bool">
        <xs:annotation><xs:documentation>Bool, default true.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="repathDistance" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="strafe" type="Bool">
        <xs:annotation><xs:documentation>Bool, default true.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="in-goal" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Vector slot: an Input or Local.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="MoveToActor">
    <xs:annotation><xs:documentation>Path-follows the actor in `in-target` (an Object) within `acceptanceRadius`, which counts both capsules, re-targeting when the slot names another actor. Fails when the target is none or destroyed; `allowPartialPath` as in MoveTo.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="acceptanceRadius" type="Float">
        <xs:annotation><xs:documentation>Float, default 50.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="allowPartialPath" type="Bool">
        <xs:annotation><xs:documentation>Bool, default true.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="strafe" type="Bool">
        <xs:annotation><xs:documentation>Bool, default true.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="in-target" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Object slot: an Input or Local.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Parallel">
    <xs:annotation><xs:documentation>Runs every child at once, each in its own lane (at most 8). Succeeds once `success` children succeeded (`all`, `any` or a count); fails once `failure` failed, or success can no longer be reached. Then cancels the children still running.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="2" maxOccurs="8"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="failure" type="xs:string">
        <xs:annotation><xs:documentation>String, default any.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="success" type="xs:string">
        <xs:annotation><xs:documentation>String, default all.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PlayerPawn">
    <xs:annotation><xs:documentation>Writes the local player's pawn (`player`, default the first); none when there is none or it is farther than `range` cm (0: any distance).</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="player" type="Int">
        <xs:annotation><xs:documentation>Int, default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="range" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="out-value" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Object slot: an Input.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Radio">
    <xs:annotation><xs:documentation>Calls the host actor's group: after `delay` seconds every other member's brain receives `event`, with the `&lt;Param name from/&gt;` children as its parameters read now, unless this actor is destroyed or has left the group by then. Succeeds at once; fails when the host actor is in no group.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Param" type="RunParam" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="delay" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="event" type="xs:string">
        <xs:annotation><xs:documentation>Name, default None.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="RandomSelector">
    <xs:annotation><xs:documentation>A Selector whose order is shuffled once per start from the instance's seeded stream. Succeeds at the first success; fails when every child failed.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="64"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="ReactiveSelector">
    <xs:annotation><xs:documentation>A Selector that, every tick, re-checks each earlier option that can be checked (a Guard's condition, a Cooldown being ready, a node with OnCheck); one that turns true cancels the running option and starts in its place. Succeeds at the first success; fails when every option failed.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="64"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Repeat">
    <xs:annotation><xs:documentation>Runs its child again after each success. Fails when the child fails; succeeds after `count` successes (0: never).</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="count" type="Int">
        <xs:annotation><xs:documentation>Int, default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Retry">
    <xs:annotation><xs:documentation>Runs its child again after each failure. Succeeds when the child succeeds; fails after `count` failed attempts (0: never).</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="count" type="Int">
        <xs:annotation><xs:documentation>Int, default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Roll">
    <xs:annotation><xs:documentation>Writes a uniform Int in `[0, count)` from the instance's seeded stream to `out-value`. Always succeeds.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="count" type="Int">
        <xs:annotation><xs:documentation>Int, default 2.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="out-value" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Int slot: a Local.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="RunEQS">
    <xs:annotation><xs:documentation>Runs the EQS `query` (with `&lt;Param&gt;` children) as the pawn and writes the chosen item's location to `out-point`. `pick` chooses Best, RandomBest5 or RandomBest25. Succeeds with an item, fails when the query returns none.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Param" type="ValueParam" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pick">
        <xs:annotation><xs:documentation>Choice, default Best.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="Best"/><xs:enumeration value="RandomBest5"/><xs:enumeration value="RandomBest25"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="query" type="xs:string">
        <xs:annotation><xs:documentation>ObjectPath.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="randomBest25" type="Bool">
        <xs:annotation><xs:documentation>Bool, default false. Legacy: kept for older files, do not use.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="out-point" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Vector slot: a Local.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Score">
    <xs:annotation><xs:documentation>Scores its one child for a UtilitySelector as `weight * in-value + bias`. Otherwise transparent: runs the child and ends with it.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bias" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="weight" type="Float">
        <xs:annotation><xs:documentation>Float, default 1.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="in-value" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Float slot: an Input or Local.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Selector">
    <xs:annotation><xs:documentation>Tries its children in order. Succeeds as soon as one succeeds; fails when the last one fails.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Sequence">
    <xs:annotation><xs:documentation>Runs its children in order. Fails as soon as one fails; succeeds when the last one succeeds.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Set">
    <xs:annotation><xs:documentation>Writes `value` (a literal of the slot's type: an enum value name, `none` for an Object) or the slot named by `from` to the Local in `to`, and succeeds.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="to" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="from" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="SimpleParallel">
    <xs:annotation><xs:documentation>Runs its first (main) child and, beside it in its own lane, loops the second (background) child. Ends with the main child's result, cancelling the background.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="2" maxOccurs="2"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="TimeLimit">
    <xs:annotation><xs:documentation>Runs its child; fails, cancelling it, once it has run `duration` seconds, drawn once per start from `duration +/- deviation` (floored at 0). Otherwise ends with the child.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="deviation" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="duration" type="Float">
        <xs:annotation><xs:documentation>Float, default 1.0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="UtilitySelector">
    <xs:annotation><xs:documentation>Tries its options highest score first (`Score` scopes; an option scoring 0 or less is skipped, none left fails). With `reevaluate` seconds it scores again and switches when another option wins by more than `margin`.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="Node" minOccurs="1" maxOccurs="64"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="margin" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="reevaluate" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Wait">
    <xs:annotation><xs:documentation>Waits `duration` seconds of tick time, drawn once per start from `duration +/- deviation` (floored at 0). Always succeeds.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="deviation" type="Float">
        <xs:annotation><xs:documentation>Float, default 0.0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="duration" type="Float">
        <xs:annotation><xs:documentation>Float, default 1.0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

</xs:schema>
