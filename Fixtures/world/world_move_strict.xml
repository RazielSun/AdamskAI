<!--
  world_move_strict: AdamskAIWorld.Navigation. world_move_to with allowPartialPath="false": a goal no path reaches
  fails the move instead of ending it at the closest point. The outcome is the state it ends in.
  Units: acceptanceRadius and repathDistance in cm.
-->
<Agent version="1" id="world_move_strict">

  <Inputs>
    <Input name="Goal" type="Vector" required="true"/>
  </Inputs>

  <Events>
    <Event name="Stop"/>
  </Events>

  <StateMachine id="m" initial="moving">
    <State id="moving" tree="move">
      <On event="tree.success" goto="arrived"/>
      <On event="tree.failure" goto="failed"/>
      <On event="Stop" goto="stopped"/>
    </State>
    <State id="arrived"/>
    <State id="failed"/>
    <State id="stopped"/>
  </StateMachine>

  <Tree id="move">
    <MoveTo id="move_goal" in-goal="Goal" acceptanceRadius="50" repathDistance="100" allowPartialPath="false"/>
  </Tree>

</Agent>
