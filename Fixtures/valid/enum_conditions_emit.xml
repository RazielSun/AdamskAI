<Agent version="1" id="enum-conditions-emit">
  <Enums>
    <Enum name="Intent"><Value name="None"/><Value name="Engage"/></Enum>
  </Enums>
  <Inputs>
    <Input name="Intent" type="Intent" default="Engage"/>
  </Inputs>
  <Events>
    <Event name="Handoff"/>
  </Events>
  <StateMachine id="mode" initial="emit">
    <State id="emit" tree="emit-handoff">
      <On event="Handoff" if="Intent" is="Engage" goto="done"/>
    </State>
    <State id="done"/>
  </StateMachine>
  <Tree id="emit-handoff">
    <Emit id="emit-handoff-now" event="Handoff"/>
  </Tree>
</Agent>
